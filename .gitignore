# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build outputs
dist/
dist-ssr/
build/
*.local
.vercel


# Cache and temporary directories
.cache/
.temp/
tmp/
