PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Primary AI engine — Groq (fast inference)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini fallback — automatically used when Groq hits its daily/rate limit,
# then automatically switches back to Groq once the cooldown window passes.
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Neon PostgreSQL — stores original + enhanced prompts for analytics/reference
# Get a free DB at https://neon.tech
# Leave blank to disable prompt logging (app still works without it)
DATABASE_URL=your_neon_postgres_url_here

MAX_PROMPT_LENGTH=10000
AI_TIMEOUT_MS=60000
