{
  "name": "tejasai-root",
  "version": "1.1.0",
  "description": "TejasAI — Give Your Ideas an Edge (AI Prompt Enhancer)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mr-baraiya/TejasAI.git"
  },
  "homepage": "https://github.com/mr-baraiya/TejasAI",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "node dev.js",
    "start": "node server/server.js",
    "build": "npm --workspace=client run build",
    "test:prompts": "node test/run_system_prompt_tests.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^0.15.0"
  }
}
