# Diagnostic and runtime data
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
logs/
*.log

# Test and coverage outputs
coverage/
.nyc_output/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE and editor files
